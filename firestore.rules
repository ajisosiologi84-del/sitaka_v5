rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /students/{studentId} {
      allow read, write: if true;
    }
    
    match /laptops/{laptopId} {
      allow read, write: if true;
    }

    match /securityLogs/{logId} {
      allow read, write: if true;
    }

    match /systemSettings/{settingId} {
      allow read, write: if true;
    }
  }
}
